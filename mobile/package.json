{
  "name": "zappyone-mobile",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "customer": "npm run start -w @zappy/customer",
    "customer:clear": "npm run start -w @zappy/customer -- --clear",
    "servicepro": "npm run start -w @zappy/servicepro",
    "servicepro:clear": "npm run start -w @zappy/servicepro -- --clear",
    "rakshak": "npm run start -w @zappy/rakshak",
    "rakshak:clear": "npm run start -w @zappy/rakshak -- --clear",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "sync:api": "node tools/sync-api-hooks.js",
    "check:api": "node tools/sync-api-hooks.js --check"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
