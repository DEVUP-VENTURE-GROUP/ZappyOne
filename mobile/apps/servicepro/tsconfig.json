{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "preserveSymlinks": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@zappy/core": [
        "./shared/core"
      ],
      "@zappy/core/*": [
        "./shared/core/*"
      ],
      "@zappy/ui": [
        "./shared/ui"
      ],
      "@zappy/ui/*": [
        "./shared/ui/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "css.d.ts",
    "../../packages/native/**/*.ts",
    "./shared/core/**/*.ts",
    "./shared/core/**/*.tsx",
    "./shared/ui/**/*.ts",
    "./shared/ui/**/*.tsx"
  ]
}
