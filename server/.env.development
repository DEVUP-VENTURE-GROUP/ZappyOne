# Zappy server — DEVELOPMENT overlay.
# Loaded by src/config/index.js on top of .env when NODE_ENV=development.
# Gitignored (.env.* in root .gitignore). NEVER commit this file.
#
# The ONLY difference from production that matters here: this points at an
# isolated database. The live `zappy` database is not reachable from a
# process that loads this file.

NODE_ENV=development

# Isolated development database on the same Atlas cluster.
MONGO_URI=mongodb+srv://aliffaizan1212_db_user:zappy@cluster0.5jall1k.mongodb.net/zappy_dev?appName=Cluster0

# Cashfree SANDBOX for development. Credentials are inherited from .env,
# which is already configured for sandbox — no live keys are used in dev.
CASHFREE_ENV=sandbox
