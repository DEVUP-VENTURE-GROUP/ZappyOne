# API origin. Empty locally (Vite proxies /api to :4000); https://api.zappyone.com in production.
VITE_API_URL=
# Must equal ADMIN_LOGIN_SLUG in server/.env (the shared API layer builds admin paths with it).
VITE_ADMIN_SLUG=
# Cashfree checkout for advertiser payments: sandbox | production
VITE_CASHFREE_ENV=
# Firebase web config — Google sign-in for event partners.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
